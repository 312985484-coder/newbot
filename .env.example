# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Configuration
ADMIN_USER_IDS=123456789,987654321
SUPER_ADMIN_USER_IDS=123456789

# Server Configuration
BOT_HOST=0.0.0.0
BOT_PORT=801

# Database
DATABASE_URL=sqlite:///telegreat.db

# Security
API_KEY_SECRET=your_secret_key_here

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=telegreat.log

# ===== Web Admin Panel =====
# Admin Panel Secret Keys (CHANGE THESE IN PRODUCTION!)
ADMIN_SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Admin Panel Server (default port: 811)
ADMIN_HOST=0.0.0.0
ADMIN_PORT=811
FLASK_DEBUG=False
